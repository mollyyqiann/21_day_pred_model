<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.mgcloseplan</string>

    <!--
        Monthly Gainer v3 - 15:45 ET same-day scorer + Telegram push.

        Runs 123_mg_close_scorer.py, which rescores on the near-complete
        session, applies the extension indicator, checks open positions
        against the exit rules, writes the plan to
        output/monthly_gainer/trade_plans/, and pushes it to Telegram.

        Why 15:45 rather than the old 19:00 job: a 19:00 plan can only be
        acted on the next morning, and these picks gap up overnight -- a
        next-open fill cost -1.87pp versus the close the backtests assumed.
        Scoring late in the SAME session removes that. A 15:55 fill lands
        within 0.04% of the official close (sd 0.39%) against +0.70%
        (sd 3.47%) for the next open, and scoring 15 minutes early leaves
        the FAVOURABLE call unchanged on 97.7% of 18,142 ticker-days.

        Fill by 15:55 ET. Fractional orders are regular-hours only, which
        the $125 slot size requires.

        PLACES NO ORDERS. It prints and sends a plan for review.
    -->

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/Users/mollyqian/anaconda3/bin/python3</string>
        <string>/Users/mollyqian/stocks/code/123_mg_close_scorer.py</string>
        <string>--notify</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>45</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>45</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>45</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>45</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>45</integer>
        </dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mollyqian/stocks</string>

    <key>StandardOutPath</key>
    <string>/Users/mollyqian/stocks/output/monthly_gainer/closeplan.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mollyqian/stocks/output/monthly_gainer/closeplan.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
